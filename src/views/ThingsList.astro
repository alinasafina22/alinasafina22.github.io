---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ThingCard from '../components/ThingCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { localizeAll } from '../i18n/content';
import { toLocale, useTranslations } from '../i18n/ui';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const things = (await localizeAll(await getCollection('things'), locale)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={t('things.title')} description={t('things.meta')}>
  <div class="container">
    <PageHeader
      title={t('things.title')}
      description={t('things.lead')}
      doodle="sparkle"
      accent="var(--color-lavender)"
    />
    {
      things.length ? (
        <div class="board">
          {things.map((t) => (
            <ThingCard thing={t} />
          ))}
        </div>
      ) : (
        <EmptyState text={t('things.empty')} hint={t('things.emptyHint')} />
      )
    }
  </div>
</BaseLayout>

<style>
  .board {
    columns: 1;
    column-gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .board {
      columns: 2;
    }
  }

  @media (min-width: 1024px) {
    .board {
      columns: 3;
    }
  }
</style>
