---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Contacts from '../components/Contacts.astro';
import { localize } from '../i18n/content';
import { toLocale, useTranslations } from '../i18n/ui';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing src/content/pages/about.md');
const page = await localize(entry, locale);
const { Content } = await render(page.source);
---

<BaseLayout title={page.data.title} description={page.data.description} lang={page.bodyLang}>
  <div class="container">
    <PageHeader title={page.data.title} doodle="cup" accent="var(--color-butter)" />
    <div class="prose">
      <Content />
    </div>
    <section class="contacts" aria-labelledby="contacts">
      <h2 id="contacts">{t('about.elsewhere')}</h2>
      <Contacts />
    </section>
  </div>
</BaseLayout>

<style>
  .contacts {
    max-width: var(--width-reading);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: var(--border);
  }
</style>
