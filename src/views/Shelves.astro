---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CategoryTabs from '../components/CategoryTabs.astro';
import MediaCard from '../components/MediaCard.astro';
import CourseCard from '../components/CourseCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { categoriesFor, getAllShelves } from '../utils/shelves';
import { localePath, toLocale, useTranslations } from '../i18n/ui';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const CATEGORIES = categoriesFor(locale);
const shelves = await getAllShelves(locale);
const counts = Object.fromEntries(CATEGORIES.map((c) => [c.key, shelves[c.key].length]));
---

<BaseLayout title={t('shelves.title')} description={t('shelves.lead')}>
  <div class="container">
    <PageHeader title={t('shelves.title')} description={t('shelves.lead')} doodle="book" accent="var(--color-peach)">
      <div class="tabs"><CategoryTabs counts={counts} /></div>
    </PageHeader>

    {
      CATEGORIES.map((cat) => {
        const items = shelves[cat.key];
        return (
          <section class="shelf" aria-labelledby={`shelf-${cat.key}`}>
            <div class="section-head">
              <h2 id={`shelf-${cat.key}`}>{cat.label}</h2>
              <a class="more-link" href={localePath(locale, `/bookshelves/${cat.key}/`)}>
                {items.length > 0 ? t('shelves.all', { n: items.length }) : t('shelves.open')}
              </a>
            </div>
            {items.length === 0 ? (
              <EmptyState text={cat.emptyText} />
            ) : (
              <ul class:list={['row', cat.layout]}>
                {items.slice(0, cat.layout === 'wide' ? 2 : 4).map((item) => (
                  <li>{cat.layout === 'wide' ? <CourseCard item={item} /> : <MediaCard item={item} />}</li>
                ))}
              </ul>
            )}
          </section>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .tabs {
    margin-top: var(--space-6);
  }

  .shelf {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: 2px solid var(--color-oat);
  }

  .row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6) var(--space-4);
  }

  .row.cover {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .row.wide {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .row.cover {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-6);
    }

    .row.wide {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
