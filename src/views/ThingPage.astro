---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DateLabel from '../components/DateLabel.astro';
import TagList from '../components/TagList.astro';
import { hostOf, isLocalUrl } from '../utils/format';
import type { Localized } from '../i18n/content';
import { localePath, toLocale, useTranslations } from '../i18n/ui';

interface Props {
  thing: Localized<'things'>;
}

const { thing } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const d = thing.data;
const { Content } = await render(thing.source);
---

<BaseLayout title={d.title} description={d.description ?? t('things.savedIn', { title: d.title })} image={d.image?.src} lang={thing.lang}>
  <div class="container">
    <Breadcrumbs items={[{ href: localePath(locale, '/things/'), label: t('things.title') }]} />
    <article class="thing">
      <header>
        <p class="top">
          <DateLabel date={d.date} prefix={t('things.saved')} />
          {d.demo && <span class="demo-badge">demo</span>}
        </p>
        <h1>{d.title}</h1>
        {d.description && <p class="lead">{d.description}</p>}
      </header>

      {
        d.url &&
          (isLocalUrl(d.url) ? (
            <p class="source">
              <a href={d.url}>
                {t('things.open')} <span aria-hidden="true">→</span>
              </a>
            </p>
          ) : (
            <p class="source">
              <a href={d.url} rel="noopener noreferrer" target="_blank">
                {t('things.visit', { host: hostOf(d.url) })} <span aria-hidden="true">↗</span>
                <span class="visually-hidden">{t('external')}</span>
              </a>
            </p>
          ))
      }

      {
        d.image && (
          <Image
            src={d.image}
            alt={d.imageAlt ?? ''}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 1024px) 900px, 100vw"
            loading="eager"
            class="hero-img"
          />
        )
      }

      <div class="prose" lang={thing.bodyLang}>
        <Content />
      </div>

      <TagList tags={d.tags} />
    </article>
  </div>
</BaseLayout>

<style>
  .thing {
    padding-top: var(--space-6);
    display: grid;
    gap: var(--space-6);
    max-width: 900px;
  }

  header {
    max-width: var(--width-reading);
  }

  .top {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  h1 {
    margin-bottom: var(--space-3);
  }

  .lead {
    margin: 0;
  }

  .hero-img {
    width: 100%;
    border-radius: var(--radius-large);
    border: var(--border);
  }

  .source {
    margin: 0;
    font-weight: 500;
  }

  .prose:empty {
    display: none;
  }
</style>
