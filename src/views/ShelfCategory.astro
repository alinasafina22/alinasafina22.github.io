---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CategoryTabs from '../components/CategoryTabs.astro';
import ShelfBrowser from '../components/ShelfBrowser.astro';
import ReadingStats from '../components/ReadingStats.astro';
import { categoriesFor, getAllShelves, getShelf, type CategoryDef } from '../utils/shelves';
import { toLocale, useTranslations } from '../i18n/ui';

interface Props {
  category: CategoryDef;
}

const { category } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const items = await getShelf(category.key, locale);
const shelves = await getAllShelves(locale);
const counts = Object.fromEntries(categoriesFor(locale).map((c) => [c.key, shelves[c.key].length]));
---

<BaseLayout title={`${category.label} · ${t('shelves.title')}`} description={category.description}>
  <div class="container">
    <PageHeader title={t('shelves.title')} description={t('shelves.lead')} doodle="book" accent="var(--color-peach)">
      <div class="tabs"><CategoryTabs current={category.key} counts={counts} /></div>
    </PageHeader>
    {category.key === 'books' && <ReadingStats items={items} />}
    <h2 class="visually-hidden">{category.label}</h2>
    <ShelfBrowser category={category} items={items} />
  </div>
</BaseLayout>

<style>
  .tabs {
    margin-top: var(--space-6);
  }
</style>
