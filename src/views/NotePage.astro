---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DateLabel from '../components/DateLabel.astro';
import TagList from '../components/TagList.astro';
import NoteCard from '../components/NoteCard.astro';
import { noteTitle, excerpt, type Note } from '../utils/format';
import { localePath, toLocale, useTranslations } from '../i18n/ui';

interface Props {
  note: Note;
  newer?: Note;
  older?: Note;
  all: Note[];
}

const { note, newer, older, all } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const link = (path: string) => localePath(locale, path);
const { Content } = await render(note.source);
const title = noteTitle(note, locale);

// Related: other notes sharing the most tags.
const related = all
  .filter((n) => n.id !== note.id)
  .map((n) => ({ n, score: n.data.tags.filter((t) => note.data.tags.includes(t)).length }))
  .filter((r) => r.score > 0)
  .sort((a, b) => b.score - a.score || b.n.data.date.getTime() - a.n.data.date.getTime())
  .slice(0, 3)
  .map((r) => r.n);
---

<BaseLayout
  title={title}
  description={note.data.description ?? excerpt(note.body, 155)}
  type="article"
  lang={note.bodyLang}
  noindex={note.data.draft}
>
  <div class="container">
    <Breadcrumbs items={[{ href: link('/notes/'), label: t('notes.title') }]} />
    <article class="note">
      <header>
        <p class="top">
          <DateLabel date={note.data.date} />
          {note.data.demo && <span class="demo-badge">demo</span>}
          {note.data.draft && <span class="demo-badge">draft</span>}
        </p>
        {note.data.title && <h1>{note.data.title}</h1>}
        <TagList tags={note.data.tags} />
      </header>
      {note.bodyLang !== locale && <p class="meta original">{t('item.originalLang', { lang: t(`lang.name.${note.bodyLang}`) })}</p>}
      <div class="prose" lang={note.bodyLang}>
        <Content />
      </div>
    </article>

    {
      (newer || older) && (
        <nav class="pager" aria-label={t('notes.more')}>
          {older ? (
            <a href={link(`/notes/${older.id}/`)} class="prev">
              <span class="meta">{t('notes.older')}</span>
              <span lang={older.lang}>{noteTitle(older, locale)}</span>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a href={link(`/notes/${newer.id}/`)} class="next">
              <span class="meta">{t('notes.newer')}</span>
              <span lang={newer.lang}>{noteTitle(newer, locale)}</span>
            </a>
          )}
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section class="related" aria-labelledby="related">
          <h2 id="related">{t('notes.related')}</h2>
          <div class="list">
            {related.map((n) => (
              <NoteCard note={n} compact />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .note {
    max-width: var(--width-reading);
    padding-top: var(--space-6);
  }

  header {
    margin-bottom: var(--space-8);
  }

  .top {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    margin-bottom: var(--space-3);
  }

  h1 {
    margin-bottom: var(--space-4);
  }

  .original {
    margin-bottom: var(--space-4);
  }

  .pager {
    max-width: var(--width-reading);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: var(--border);
  }

  .pager a {
    display: grid;
    gap: var(--space-1);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.3;
  }

  .pager a:hover span:last-child {
    text-decoration: underline;
    text-decoration-color: var(--color-dusty-rose);
  }

  .next {
    text-align: right;
  }

  .related {
    max-width: var(--width-reading);
    margin-top: var(--space-12);
  }

  .related .list {
    border-top: var(--border);
  }
</style>
