---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { localePath, toLocale, useTranslations } from '../i18n/ui';
import { NT } from '../i18n/notes-trainer';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const L = NT[locale];
const u = L.ui;
---

<BaseLayout title={L.title} description={L.lead}>
  <div class="container nt-page">
    <Breadcrumbs items={[{ href: localePath(locale, '/things/'), label: t('things.title') }]} />
    <header class="nt-head">
      <h1>{L.title}</h1>
      <p class="lead">{L.lead}</p>
    </header>

    <div class="nt">
      <div class="nt-top"><span class="score" id="best"></span></div>

      <div class="controls">
        <div class="row">
          <span class="lab">{u.mode}</span>
          <div class="seg" id="seg-mode">
            <button type="button" data-v="read">{u.read}</button>
            <button type="button" data-v="ear">{u.ear}</button>
            <button type="button" data-v="chords">{u.chords}</button>
            <button type="button" data-v="scales">{u.scales}</button>
            <button type="button" data-v="rhythm">{u.rhythm}</button>
          </div>
        </div>
        <div class="row" id="row-rtask" hidden>
          <span class="lab">{u.rtask}</span>
          <div class="seg" id="seg-rtask">
            <button type="button" data-v="value">{u.rValue}</button>
            <button type="button" data-v="tap">{u.rTap}</button>
          </div>
        </div>
        <div class="row" id="row-rlevel" hidden>
          <span class="lab">{u.rlevel}</span>
          <div class="seg" id="seg-rlevel">
            <button type="button" data-v="1">{u.lvl1}</button>
            <button type="button" data-v="2">{u.lvl2}</button>
            <button type="button" data-v="3">{u.lvl3}</button>
          </div>
        </div>
        <div class="row" id="row-piece" hidden>
          <span class="lab">{u.piece}</span>
          <div class="seg" id="seg-piece">
            {Object.entries(L.pieces).map(([v, label]) => <button type="button" data-v={v}>{label}</button>)}
          </div>
        </div>
        <div class="row" id="row-ctype" hidden>
          <span class="lab">{u.types}</span>
          <div class="seg" id="seg-ctype">
            <button type="button" data-v="triad">{u.triad}</button>
            <button type="button" data-v="inv">{u.inv}</button>
            <button type="button" data-v="dimaug">{u.dimaug}</button>
            <button type="button" data-v="sev">{u.sev}</button>
            <button type="button" data-v="d7">{u.d7}</button>
          </div>
        </div>
        <div class="row" id="row-hand" hidden>
          <span class="lab">{u.hand}</span>
          <div class="seg" id="seg-hand">
            <button type="button" data-v="R">{u.right}</button>
            <button type="button" data-v="L">{u.left}</button>
            <button type="button" data-v="B" id="h-both" hidden>{u.bothHands}</button>
          </div>
        </div>
        <div class="row" id="row-task" hidden>
          <span class="lab">{u.task}</span>
          <div class="seg" id="seg-task">
            <button type="button" data-v="name">{u.byName}</button>
            <button type="button" data-v="notes">{u.byNotes}</button>
          </div>
        </div>
        <div class="row" id="row-clef">
          <span class="lab">{u.clef}</span>
          <div class="seg" id="seg-clef">
            <button type="button" data-v="treble">{u.treble}</button>
            <button type="button" data-v="bass">{u.bass}</button>
            <button type="button" data-v="both">{u.both}</button>
          </div>
        </div>
        <div class="row" id="row-range">
          <span class="lab">{u.range}</span>
          <div class="seg" id="seg-range">
            <button type="button" data-v="staff">{u.staff}</button>
            <button type="button" data-v="ledger">{u.ledger}</button>
          </div>
        </div>
        <div class="row" id="row-tempo" hidden>
          <span class="lab">{u.tempo}</span>
          <button class="tool" id="metroBtn" type="button" aria-pressed="false"><i class="beat-dot" id="beatDot"></i>{u.metro}</button>
          <span class="stepper">
            <button class="tool" id="bpmDown" type="button" aria-label={u.tempoDown}>−</button>
            <output id="bpmOut">80</output><span class="unit">{u.bpm}</span>
            <button class="tool" id="bpmUp" type="button" aria-label={u.tempoUp}>+</button>
          </span>
        </div>
        <div class="row" id="row-sub" hidden>
          <span class="lab">{u.perBeat}</span>
          <div class="seg" id="seg-sub">
            <button type="button" data-v="1">{u.sub1}</button>
            <button type="button" data-v="2">{u.sub2}</button>
          </div>
        </div>
        <div class="row">
          <span class="lab">{u.piano}</span>
          <button class="tool" id="midiBtn" type="button">{u.connect}</button>
          <div class="seg" id="seg-oct" hidden>
            <button type="button" data-v="exact">{u.exact}</button>
            <button type="button" data-v="any">{u.any}</button>
          </div>
        </div>
        <p class="midi-status" id="midiStatus" hidden></p>
      </div>

      <section class="card" aria-live="polite">
        <div class="progress">
          <span id="count">1 / 20</span><div class="bar"><i id="bar"></i></div><span id="right">0 ✓</span>
        </div>
        <div id="game">
          <div class="task" id="task" hidden></div>
          <div class="finger" id="finger" hidden></div>
          <svg class="staff" id="staff" viewBox="0 0 300 150" role="img" aria-label={u.staffAria}></svg>
          <div class="feedback idle" id="fb">{L.ask}</div>
        </div>
        <div class="summary" id="sum" hidden></div>
      </section>

      <div class="keys" id="keys"></div>
      <div class="keys" id="rkeys" hidden></div>
      <div class="tap-box" id="tapBox" hidden>
        <div class="tools">
          <button class="tool primary" id="rStart" type="button">{u.start}</button>
          <button class="tool" id="rRetry" type="button" hidden>{u.retry}</button>
          <button class="tool primary" id="rNext" type="button" hidden>{u.next}</button>
        </div>
        <button class="tap-btn" id="tapBtn" type="button">{u.tap}</button>
      </div>
      <div class="piano" id="piano" hidden>
        <svg id="pianoSvg" viewBox="0 0 300 100" role="img" aria-label={u.pianoAria}></svg>
        <div class="tools">
          <button class="tool primary" id="check" type="button">{u.check}</button>
          <button class="tool" id="clear" type="button">{u.clear}</button>
          <button class="tool primary" id="nextBtn" type="button" hidden>{u.next}</button>
        </div>
      </div>

      <div class="tools">
        <button class="tool" id="play" type="button">{u.play}</button>
        <button class="tool" id="hintBtn" type="button">{u.hint}</button>
        <button class="tool" id="restart" type="button">{u.restart}</button>
      </div>
      <div class="hint" id="hint" hidden></div>

      <section class="memo" id="memo" hidden>
        <h2>{u.memoH}</h2>
        <div class="memo-grid" id="memoGrid"></div>
        <p>{u.memoTree}</p>
      </section>

      <details class="crib-box">
        <summary>{u.crib}</summary>
        <div class="crib">
          <figure class="crib-staff">
            <figcaption><h2>{u.trebleH}</h2><span>{u.trebleSub}</span></figcaption>
            <div class="scroll"><svg class="staff crib-svg" id="cribTreble" role="img" aria-label={u.trebleAria}></svg></div>
            <p class="mnem">{u.linesFrom} <b class="ln">{u.trebleLines}</b> &nbsp; {u.spaces} <b class="sp">{u.trebleSpaces}</b></p>
          </figure>
          <figure class="crib-staff">
            <figcaption><h2>{u.bassH}</h2><span>{u.bassSub}</span></figcaption>
            <div class="scroll"><svg class="staff crib-svg" id="cribBass" role="img" aria-label={u.bassAria}></svg></div>
            <p class="mnem">{u.linesFrom} <b class="ln">{u.bassLines}</b> &nbsp; {u.spaces} <b class="sp">{u.bassSpaces}</b></p>
          </figure>
          <div class="legend">
            <span><i class="sw"></i>{u.onLine}</span><span><i class="sw sp"></i>{u.inSpace}</span><span><i class="sw an"></i>{u.anchors}</span>
          </div>
          <div class="crib-cols">
            <div>
              <h2>{u.fingersH}</h2>
              <dl>{u.fingers.map(([a, b]) => <><dt>{a}</dt><dd>{b}</dd></>)}</dl>
            </div>
            <div>
              <h2>{u.fasterH}</h2>
              <dl>{u.faster.map(([a, b]) => <><dt>{a}</dt><dd>{b}</dd></>)}</dl>
            </div>
          </div>
        </div>
      </details>
      <p class="foot">{u.foot}</p>
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/notes-trainer';
</script>

<style is:global>
  /* Notes trainer. Global because the staff and keyboard are drawn by the script.
     Piano keys stay white and black in every theme; everything else uses site tokens. */
  .nt-page {
    padding-top: var(--space-6);
    padding-bottom: var(--space-12);
  }
  .nt-head {
    max-width: var(--width-reading);
    margin-bottom: var(--space-6);
  }
  .nt-head h1 {
    margin-bottom: var(--space-3);
  }
  .nt-head .lead {
    margin: 0;
  }

  .nt {
    --nt-key-white: #fdfbf6;
    --nt-key-black: #2a2c28;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .nt [hidden] {
    display: none !important;
  }
  .nt .nt-top {
    min-height: 1em;
  }
  .nt .score {
    font: var(--text-meta) / 1.4 var(--font-mono);
    color: var(--color-muted);
  }
  .nt .score b {
    color: var(--color-ink);
    font-weight: 500;
  }

  .nt .controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .nt .row {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    flex-wrap: wrap;
  }
  .nt .row > .lab,
  .nt .finger .lab {
    font: var(--text-meta) var(--font-mono);
    color: var(--color-muted);
  }
  .nt .row > .lab {
    width: 82px;
    flex: none;
  }
  .nt .seg {
    display: inline-flex;
    flex-wrap: wrap;
    background: var(--color-card);
    border: var(--border);
    border-radius: var(--radius-pill);
    padding: 2px;
  }
  .nt .seg button {
    font-size: var(--text-small);
    color: var(--color-muted);
    background: none;
    border: 0;
    border-radius: var(--radius-pill);
    padding: 5px 12px;
    cursor: pointer;
    transition: background var(--transition), color var(--transition);
  }
  .nt .seg button:hover {
    color: var(--color-ink);
  }
  .nt .seg button[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .nt .card {
    background: var(--color-card);
    border: var(--border);
    border-radius: var(--radius-large);
    padding: var(--space-3) var(--space-3) var(--space-2);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .nt .progress {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font: var(--text-meta) var(--font-mono);
    color: var(--color-muted);
    padding: 0 var(--space-1);
  }
  .nt .bar {
    flex: 1;
    height: 4px;
    background: var(--color-oat);
    border-radius: 2px;
    overflow: hidden;
  }
  .nt .bar i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--color-dusty-rose);
    transition: width 0.25s;
  }

  .nt svg.staff {
    width: 100%;
    height: auto;
    display: block;
  }
  .nt svg.staff .line {
    stroke: var(--color-muted);
    stroke-width: 1.1;
  }
  .nt svg.staff .clef,
  .nt svg.staff .note,
  .nt svg.staff .acc {
    fill: var(--color-ink);
  }
  .nt svg.staff .note {
    transition: fill 0.15s;
  }
  .nt svg.staff .note.ok {
    fill: var(--color-success);
  }
  .nt svg.staff .note.bad {
    fill: var(--color-error);
  }
  .nt svg.staff .ledger {
    stroke: var(--color-ink);
    stroke-width: 1.3;
  }
  .nt svg.staff .note.ghost {
    fill: var(--color-error);
    opacity: 0.45;
  }
  .nt svg.staff .note.cur {
    fill: var(--color-focus);
  }
  .nt svg.staff .cur-mark {
    fill: var(--color-butter);
  }
  .nt svg.staff .fing.done {
    fill: var(--color-muted);
    font-weight: 500;
  }
  .nt svg.staff .fing.now {
    font-size: 14px;
  }
  .nt svg.staff .acc.sm {
    font-size: 15px;
  }
  .nt svg.staff .ledger.ghost {
    stroke: var(--color-error);
    opacity: 0.45;
  }
  .nt svg.staff .ask {
    fill: var(--color-muted);
    font: 600 30px var(--font-display);
  }
  .nt svg.staff .acc {
    font: 19px 'Apple Symbols', 'Segoe UI Symbol', 'Noto Music', 'DejaVu Sans', serif;
  }
  .nt svg.staff .fing {
    fill: var(--color-focus);
    font: 700 12px var(--font-body);
  }

  .nt .feedback {
    min-height: 48px;
    text-align: center;
    padding: 2px var(--space-2);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nt .feedback .big {
    font: 600 22px var(--font-display);
  }
  .nt .feedback small {
    display: block;
    font-size: 13px;
    color: var(--color-muted);
    margin-top: 2px;
  }
  .nt .feedback.ok {
    color: var(--color-success);
  }
  .nt .feedback.bad {
    color: var(--color-error);
  }
  .nt .feedback.idle {
    color: var(--color-muted);
  }

  .nt .keys {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 5px;
  }
  .nt .keys button {
    font: 600 18px/1 var(--font-display);
    color: var(--color-ink);
    background: var(--color-card);
    border: var(--border);
    border-bottom-width: 3px;
    border-radius: var(--radius-button);
    padding: 14px 0 12px;
    cursor: pointer;
    transition: transform 0.06s, border-color var(--transition);
  }
  .nt .keys button:hover:not(:disabled) {
    border-color: var(--color-muted);
  }
  .nt .keys button:active {
    transform: translateY(1px);
  }
  .nt .keys button.ok {
    background: var(--color-sage);
    border-color: var(--color-success);
    color: var(--color-ink);
  }
  .nt .keys button.bad {
    background: var(--color-peach);
    border-color: var(--color-error);
    color: var(--color-ink);
  }
  .nt .keys button:disabled {
    cursor: default;
  }

  .nt .tools {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .nt .tool {
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-ink);
    background: none;
    border: var(--border);
    border-radius: var(--radius-button);
    padding: 7px 12px;
    cursor: pointer;
    transition: border-color var(--transition);
  }
  .nt .tool:hover {
    border-color: var(--color-muted);
  }
  .nt .tool.primary {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }
  .nt .tool.on {
    border-color: var(--color-success);
    color: var(--color-success);
  }
  .nt .midi-status {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-muted);
    padding-left: 90px;
  }
  @media (max-width: 480px) {
    .nt .midi-status {
      padding-left: 0;
    }
  }
  .nt .hint {
    font-size: var(--text-small);
    color: var(--color-ink);
    background: var(--color-butter);
    border-radius: var(--radius-button);
    padding: var(--space-2) var(--space-3);
  }

  /* chords */
  .nt .task {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-1) var(--space-2) 0;
  }
  .nt .task b {
    font: 600 20px / var(--leading-heading) var(--font-display);
    text-wrap: balance;
  }
  .nt .task span {
    font: var(--text-meta) var(--font-mono);
    color: var(--color-muted);
  }
  .nt .finger {
    text-align: center;
    font-size: 13px;
    color: var(--color-muted);
  }
  .nt .finger .lab {
    margin-right: var(--space-1);
  }
  .nt .finger b {
    color: var(--color-ink);
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }
  .nt .piano {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .nt #pianoSvg {
    width: 100%;
    height: auto;
    display: block;
    touch-action: manipulation;
    user-select: none;
  }
  .nt .pk {
    cursor: pointer;
    stroke: var(--color-muted);
    stroke-width: 1;
  }
  .nt .pk.w {
    fill: var(--nt-key-white);
  }
  .nt .pk.b {
    fill: var(--nt-key-black);
  }
  .nt .pk.w.sel {
    fill: var(--color-butter);
  }
  .nt .pk.b.sel {
    fill: var(--color-focus);
  }
  .nt .pk.w.good {
    fill: var(--color-sage);
  }
  .nt .pk.b.good {
    fill: var(--color-sage-deep);
  }
  .nt .pk.w.wrong {
    fill: var(--color-peach);
  }
  .nt .pk.b.wrong {
    fill: var(--color-error);
  }
  .nt .pk.miss {
    stroke: var(--color-success);
    stroke-width: 2;
    stroke-dasharray: 4 2;
  }
  .nt .fc {
    fill: var(--color-focus);
    pointer-events: none;
  }
  .nt .ft {
    fill: var(--color-paper);
    font: 700 10px var(--font-body);
    pointer-events: none;
  }
  .nt .c4 {
    fill: #77756c;
    font: 9px var(--font-body);
    pointer-events: none;
  }

  /* round summary */
  .nt .summary {
    text-align: center;
    padding: var(--space-4) var(--space-3) var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: center;
  }
  .nt .summary .result {
    font: 600 52px/1 var(--font-display);
    font-variant-numeric: tabular-nums;
  }
  .nt .summary .result small {
    font-size: 24px;
    color: var(--color-muted);
  }
  .nt .summary p {
    margin: 0;
    color: var(--color-muted);
    max-width: 40ch;
  }
  .nt .misses {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .nt .misses span {
    font-size: 13px;
    background: var(--color-peach);
    color: var(--color-ink);
    border-radius: var(--radius-pill);
    padding: 2px 10px;
  }

  /* cheat sheet */
  .nt .crib-box {
    background: var(--color-card);
    border: var(--border);
    border-radius: var(--radius-large);
    padding: var(--space-1) var(--space-4);
  }
  .nt .crib-box summary {
    cursor: pointer;
    font-weight: 600;
    padding: 10px 0;
    font-size: var(--text-small);
  }
  .nt .crib {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    font-size: 13.5px;
  }
  .nt .crib > *,
  .nt .crib-cols > * {
    min-width: 0;
  }
  .nt .crib h2 {
    font-size: 17px;
    margin: 0 0 var(--space-1);
  }
  .nt .crib-staff {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .nt .crib-staff figcaption {
    display: flex;
    flex-direction: column;
  }
  .nt .crib-staff figcaption span {
    color: var(--color-muted);
    font-size: 13px;
  }
  .nt .scroll {
    overflow-x: auto;
  }
  .nt .crib-svg {
    min-width: 560px;
  }
  .nt svg.staff .note.sp {
    fill: var(--color-focus);
  }
  .nt svg.staff .halo {
    fill: var(--color-butter);
    stroke: var(--color-muted);
    stroke-width: 1;
  }
  .nt svg.staff .cn {
    font: 600 12px var(--font-body);
    fill: var(--color-ink);
  }
  .nt svg.staff .cn.sp {
    fill: var(--color-focus);
  }
  .nt svg.staff .co {
    font: 10.5px var(--font-body);
    fill: var(--color-muted);
  }
  .nt svg.staff .br {
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 1;
  }
  .nt .mnem {
    margin: 0;
    font-size: 13px;
    color: var(--color-muted);
  }
  .nt .mnem .ln {
    color: var(--color-ink);
  }
  .nt .mnem .sp {
    color: var(--color-focus);
  }
  .nt .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 12.5px;
    color: var(--color-muted);
  }
  .nt .legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .nt .sw {
    width: 12px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
    background: var(--color-ink);
  }
  .nt .sw.sp {
    background: var(--color-focus);
  }
  .nt .sw.an {
    background: var(--color-butter);
    border: 1px solid var(--color-muted);
    width: 14px;
    height: 14px;
