---
/*
 * Grid of shelf items with status filters, search and sorting.
 * Works without JavaScript (shows everything); the script only hides and reorders cards.
 */
import MediaCard from './MediaCard.astro';
import CourseCard from './CourseCard.astro';
import EmptyState from './EmptyState.astro';
import type { CategoryDef, ShelfItem } from '../utils/shelves';

interface Props {
  category: CategoryDef;
  items: ShelfItem[];
}
const { category, items } = Astro.props;
const countFor = (key: string) => items.filter((i) => i.status.key === key).length;
const label = category.label.toLowerCase();

/* Tags used on this shelf, most common first. */
const tagCounts = new Map<string, number>();
for (const item of items) for (const t of item.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const allTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

/*
 * Blocks: in-progress first, then finished items by year (newest first),
 * then items without dates, then the wishlist.
 */
const IN_PROGRESS = ['reading', 'learning', 'watching'];
const groupOf = (item: ShelfItem): string => {
  if (IN_PROGRESS.includes(item.status.key)) return 'now';
  if (item.status.key.startsWith('want-')) return 'later';
  return item.sortDate > 0 ? String(new Date(item.sortDate).getUTCFullYear()) : 'undated';
};
const NOW_LABEL: Record<string, string> = { books: 'Reading now', courses: 'Learning now', 'tv-shows': 'Watching now' };
const groupLabel = (key: string) =>
  key === 'now' ? (NOW_LABEL[category.key] ?? 'In progress')
  : key === 'later' ? (category.statuses.find((st) => st.key.startsWith('want-'))?.label ?? 'Later')
  : key === 'undated' ? 'Earlier'
  : key;
const rank = (key: string) => (key === 'now' ? 1e9 : key === 'later' ? -2 : key === 'undated' ? -1 : Number(key));
const groupMap = new Map<string, ShelfItem[]>();
for (const item of items) {
  const key = groupOf(item);
  groupMap.set(key, [...(groupMap.get(key) ?? []), item]);
}
const groups = [...groupMap.entries()].sort((a, b) => rank(b[0]) - rank(a[0]));

/* Inside a year, split by month (newest first). Other blocks stay as one list. */
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const monthsOf = (key: string, groupItems: ShelfItem[]): Array<[string, ShelfItem[]]> => {
  if (!/^\d{4}$/.test(key)) return [['', groupItems]];
  const byMonth = new Map<number, ShelfItem[]>();
  for (const item of groupItems) {
    const m = new Date(item.sortDate).getUTCMonth();
    byMonth.set(m, [...(byMonth.get(m) ?? []), item]);
  }
  return [...byMonth.entries()].sort((a, b) => b[0] - a[0]).map(([m, list]) => [MONTHS[m], list]);
};
---

<div class="browser" data-shelf>
  {
    items.length > 0 && (
      <div class="controls">
        <div class="chips" role="group" aria-label="Filter by status">
          <button type="button" class="chip" data-filter="all" aria-pressed="true">
            All <span class="count">{items.length}</span>
          </button>
          {category.statuses.map((s) => (
            <button type="button" class="chip" data-filter={s.key} aria-pressed="false" disabled={countFor(s.key) === 0}>
              <span aria-hidden="true">{s.glyph}</span> {s.label} <span class="count">{countFor(s.key)}</span>
            </button>
          ))}
        </div>
        {allTags.length > 0 && (
          <div class="chips tag-chips" role="group" aria-label="Filter by tag">
            <button type="button" class="chip tag-chip" data-tag="" aria-pressed="true">
              All tags
            </button>
            {allTags.map(([t, n]) => (
              <button type="button" class="chip tag-chip" data-tag={t} aria-pressed="false">
                #{t} <span class="count">{n}</span>
              </button>
            ))}
          </div>
        )}
        <div class="tools">
          <label class="search">
            <span class="visually-hidden">Search {label}</span>
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
              <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8" />
              <path d="M13 13l4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
            <input type="search" placeholder={`Search ${label}…`} data-search autocomplete="off" />
          </label>
          <label class="sort">
            <span class="meta">sort</span>
            <select data-sort>
              <option value="recent">Recently updated</option>
              <option value="title">Title A–Z</option>
              <option value="rating">Rating</option>
            </select>
          </label>
        </div>
      </div>
    )
  }

  {
    items.length === 0 ? (
      <EmptyState text={category.emptyText} hint={`Add a Markdown file to src/content/${category.collection === 'tvShows' ? 'tv-shows' : category.key}/`} />
    ) : (
      <>
        {groups.map(([key, groupItems], gi) => (
          <section class="group" data-group aria-labelledby={`group-${key}`}>
            <h3 class="group-title" id={`group-${key}`}>
              {groupLabel(key)}
              <span class="group-count meta" data-group-count>{groupItems.length}</span>
            </h3>
            {monthsOf(key, groupItems).map(([month, monthItems]) => (
              <div class="month" data-month>
                {month && <h4 class="month-title meta">{month}</h4>}
                <ul class:list={['grid', category.layout]} data-grid>
                  {monthItems.map((item, i) => (
                    <li
                      data-status={item.status.key}
                      data-title={item.title.toLowerCase()}
                      data-search-text={[item.title, item.creator, item.subline, ...item.tags].filter(Boolean).join(' ').toLowerCase()}
                      data-rating={item.rating ?? 0}
                      data-tags={`|${item.tags.join('|')}|`}
                      data-order={i}
                    >
                      {category.layout === 'wide' ? <CourseCard item={item} /> : <MediaCard item={item} eager={gi === 0 && i < 4} />}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
        ))}
        <p class="live visually-hidden" aria-live="polite" data-live />
        <div class="no-results" data-empty hidden>
          <EmptyState text="Nothing on this shelf matches." hint="Try another status or a shorter search." />
        </div>
      </>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-shelf]').forEach((root) => {
    const sections = [...root.querySelectorAll<HTMLElement>('[data-group]')];
    if (!sections.length) return;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-grid] > li')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const tagButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-tag]')];
    const search = root.querySelector<HTMLInputElement>('[data-search]');
    const sort = root.querySelector<HTMLSelectElement>('[data-sort]');
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const live = root.querySelector<HTMLElement>('[data-live]');

    const params = new URLSearchParams(location.search);
    let status = params.get('status') ?? 'all';
    if (!buttons.some((b) => b.dataset.filter === status && !b.disabled)) status = 'all';
    let tag = params.get('tag') ?? '';
    if (!tagButtons.some((b) => b.dataset.tag === tag)) tag = '';

    const apply = () => {
      const q = (search?.value ?? '').trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const ok =
          (status === 'all' || card.dataset.status === status) &&
          (!tag || (card.dataset.tags ?? '').includes(`|${tag}|`)) &&
          (!q || (card.dataset.searchText ?? '').includes(q));
        card.hidden = !ok;
        if (ok) shown++;
      }
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === status)));
      tagButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tag === tag)));
      if (empty) empty.hidden = shown > 0;
      if (live) live.textContent = `${shown} shown`;

      const mode = sort?.value ?? 'recent';
      for (const section of sections) {
        let visible = 0;
        section.querySelectorAll<HTMLElement>('[data-month]').forEach((month) => {
          const grid = month.querySelector<HTMLElement>('[data-grid]')!;
          const own = [...grid.children] as HTMLElement[];
          const shownHere = own.filter((c) => !c.hidden).length;
          month.hidden = shownHere === 0;
          visible += shownHere;
          own.sort((a, b) => {
            if (mode === 'title') return (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '');
            if (mode === 'rating') return Number(b.dataset.rating) - Number(a.dataset.rating) || Number(a.dataset.order) - Number(b.dataset.order);
            return Number(a.dataset.order) - Number(b.dataset.order);
          });
          grid.append(...own);
        });
        section.hidden = visible === 0;
        const count = section.querySelector<HTMLElement>('[data-group-count]');
        if (count) count.textContent = String(visible);
      }

      const url = new URL(location.href);
      if (status === 'all') url.searchParams.delete('status');
      else url.searchParams.set('status', status);
      if (!tag) url.searchParams.delete('tag');
      else url.searchParams.set('tag', tag);
      history.replaceState(null, '', url);
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        status = b.dataset.filter ?? 'all';
        apply();
      }),
    );
    tagButtons.forEach((b) =>
      b.addEventListener('click', () => {
        tag = b.dataset.tag ?? '';
        apply();
      }),
    );
    search?.addEventListener('input', apply);
    sort?.addEventListener('change', apply);
    apply();
  });
</script>

<style>
  .controls {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .tag-chip {
    min-height: 32px;
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .tag-chip[aria-pressed='false'] {
    background: color-mix(in srgb, var(--color-sage) 35%, transparent);
    border-color: transparent;
  }

  .tag-chip[aria-pressed='false']:hover {
    background: var(--color-sage);
  }

  .chip:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .chip:disabled:hover {
    background: transparent;
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .search {
    flex: 1 1 220px;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-3);
    border: var(--border);
    border-radius: var(--radius-button);
    background: var(--color-card);
    color: var(--color-muted);
  }

  .search:focus-within {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 16px; /* prevents iOS zoom on focus */
    color: var(--color-ink);
    outline: none;
  }

  .sort {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .sort select {
    min-height: 44px;
    padding: 0 var(--space-3);
    border: var(--border);
    border-radius: var(--radius-button);
    background: var(--color-card);
    font: inherit;
    font-size: 15px;
    color: var(--color-ink);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-8) var(--space-4);
  }

  .grid.cover {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .grid.wide {
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .grid {
      gap: var(--space-8) var(--space-6);
    }

    .grid.wide {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 480px) {
    .grid.cover {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 640px) {
    .grid.cover {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-8) var(--space-4);
    }
  }

  @media (min-width: 1024px) {
    .grid.cover {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--space-8) var(--space-6);
    }
  }

  .grid.cover :global(.title) {
    font-size: 16px;
  }

  li[hidden],
  .month[hidden],
  .group[hidden] {
    display: none;
  }

  .group + .group {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 2px solid var(--color-oat);
  }

  .group-title {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    font-size: var(--text-section);
  }

  .month + .month {
    margin-top: var(--space-8);
  }

  .month-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--text-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .month-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .group-count {
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: var(--color-oat);
    color: var(--color-ink);
  }
</style>
