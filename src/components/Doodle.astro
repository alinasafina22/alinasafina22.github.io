---
/*
 * Small original hand-drawn accents. Purely decorative: always hidden from assistive tech.
 * Lines are slightly wobbly on purpose.
 */
export type DoodleName = 'star' | 'arrow' | 'flower' | 'book' | 'computer' | 'sparkle' | 'loop-arrow' | 'cup';

interface Props {
  name: DoodleName;
  size?: number;
  color?: string;
  fill?: string;
  class?: string;
}

const { name, size = 24, color = 'currentColor', fill = 'none', class: className } = Astro.props;
---

<svg
  class:list={['doodle', className]}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  aria-hidden="true"
  focusable="false"
  style={`color:${color}`}
>
  <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
    {
      name === 'star' && (
        <path
          fill={fill}
          d="M24 5.5c1.6 5.2 3 9.8 4.6 13.4 4.3.4 9 .5 13.9.9-3.8 3.1-7.4 5.9-10.6 8.9 1.2 4.6 2.6 9 3.6 13.7-4-2.8-7.8-5.4-11.6-7.6-3.9 2.6-7.6 5.1-11.4 7.9 1.1-4.8 2.4-9.3 3.7-13.8-3.3-3-6.8-5.8-10.4-9 4.9-.4 9.5-.4 13.8-.9 1.6-4 3-8.5 4.4-13.5Z"
        />
      )
    }
    {
      name === 'sparkle' && (
        <path fill={fill} d="M24 6c1 9.6 4.4 15.2 17 18-12.4 2.6-16 8.4-17 18-1.2-9.8-4.6-15.4-17-18 12.6-2.6 15.8-8.2 17-18Z" />
      )
    }
    {
      name === 'arrow' && (
        <>
          <path d="M5 30c8-1 15-6 22-11.5 4-3.2 8-6 15-8.5" />
          <path d="M33 7.5c3.2.3 6.3.8 9.2 1.6-1.2 2.9-2.6 5.6-4.4 8.3" />
        </>
      )
    }
    {
      name === 'loop-arrow' && (
        <>
          <path d="M6 36c6-2 11-7 12-13 .8-5-3-8-6-5.5-3.4 2.9 1.4 9.5 9 9.2 8-.3 14-6 20-15" />
          <path d="M33 10.5c3-.6 5.8-.8 8.6-.8-.2 3-.9 6-1.9 8.8" />
        </>
      )
    }
    {
      name === 'flower' && (
        <>
          <path
            fill={fill}
            d="M24 21c-4-6-1.5-12.5 0-13 2 .8 4 7 0 13Zm3 3c6-3.6 12-1 12.6.6-.8 2-7 3.6-12.6-.6Zm-3 3.2c3.8 5.8 1.2 12.4-.3 12.9-2-.9-3.8-7 .3-12.9ZM21 24c-6 3.4-12 .8-12.6-.8.9-1.9 7-3.4 12.6.8Z"
          />
          <circle cx="24" cy="24" r="2.6" />
        </>
      )
    }
    {
      name === 'book' && (
        <>
          <path fill={fill} d="M24 13.5c-5-3-11-3.5-17-2.6v24.6c6-.8 12-.2 17 2.8 5-3 11-3.6 17-2.8V10.9c-6-.9-12-.4-17 2.6Z" />
          <path d="M24 13.5v24.8" />
        </>
      )
    }
    {
      name === 'computer' && (
        <>
          <path fill={fill} d="M8.5 10.5c10.5-.6 20.6-.7 31-.2.6 6.5.6 13 .2 19.4-10.4.6-20.8.6-31.2.1-.4-6.4-.4-12.8 0-19.3Z" />
          <path d="M19 37.5c3.4-.4 6.8-.4 10.2 0M24 30v7.3" />
          <path d="M15 19.5l3 2.5-3 2.6M21.5 25h6" />
        </>
      )
    }
    {
      name === 'cup' && (
        <>
          <path fill={fill} d="M10 18c8.6-.6 17.4-.6 26 0-.4 7.4-2.4 14.6-6 19.4-4.6.6-9.4.6-14 0-3.6-4.8-5.6-12-6-19.4Z" />
          <path d="M36 21.5c5-1 6.6 5.6 1.4 7.8-1 .4-2 .6-3.2.6" />
          <path d="M18 7c-1.6 2.4 1.6 4-.2 6.6M25 6.4c-1.6 2.4 1.6 4.2-.2 6.8" />
        </>
      )
    }
  </g>
</svg>

<style>
  .doodle {
    flex: none;
    display: inline-block;
    overflow: visible;
  }
</style>
