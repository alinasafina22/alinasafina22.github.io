---
import { LOCALES, localePath, switchLocalePath, toLocale, useTranslations, LOCALE_NAMES } from '../i18n/ui';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const NAV = [
  { href: '/', label: t('nav.home') },
  { href: '/notes/', label: t('nav.notes') },
  { href: '/bookshelves/', label: t('nav.bookshelves') },
  { href: '/things/', label: t('nav.things') },
  { href: '/recipes/', label: t('nav.recipes') },
  { href: '/about/', label: t('nav.about') },
];

// Path without the language prefix, so "active" works the same in both languages.
const path = switchLocalePath(Astro.url.pathname, 'en').replace(/\/?$/, '/');
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container bar">
    <a href={localePath(locale, '/')} class="logo" aria-label={`azh., ${t('nav.home')}`}>
      azh<span class="dot">.</span>
      <svg class="squiggle" viewBox="0 0 60 8" aria-hidden="true" focusable="false">
        <path d="M1 5c6-4 9 2 15-1s9-3 14 0 9 2 14-1 9-2 15 1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </a>

    <div class="right">
    <button type="button" class="theme" aria-pressed="false" aria-label={t('theme.dark')} title={t('theme.dark')} data-theme-toggle>
      <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
      </svg>
      <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>
    <nav class="lang" aria-label={t('lang.switch')}>
      {
        LOCALES.map((l) => (
          <a
            href={switchLocalePath(Astro.url.pathname, l)}
            hreflang={l}
            lang={l}
            aria-current={l === locale ? 'true' : undefined}
            title={LOCALE_NAMES[l]}
          >
            {l.toUpperCase()}
          </a>
        ))
      }
    </nav>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
        <path class="l1" d="M4 7h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        <path class="l2" d="M4 12h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        <path class="l3" d="M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
      <span class="visually-hidden">{t('menu')}</span>
    </button>

    <nav id="site-nav" class="nav" aria-label={t('nav.main')}>
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={localePath(locale, item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    </div>
  </div>
</header>

<script>
  // Theme switch: flip light/dark, remember the choice, keep the button state in sync.
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const sync = () => toggle?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  sync();
  toggle?.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', root.dataset.theme);
    } catch {}
    sync();
  });
  // Follow the system setting while there is no saved choice.
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let saved = null;
    try {
      saved = localStorage.getItem('theme');
    } catch {}
    if (!saved) {
      root.dataset.theme = e.matches ? 'dark' : 'light';
      sync();
    }
  });
</script>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const nav = document.getElementById('site-nav');
  if (button && nav) {
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('open', open);
    };
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('open')) {
        setOpen(false);
        button.focus();
      }
    });
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  }
</script>

<style>
  .site-header {
    border-bottom: var(--border);
    position: relative;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 68px;
  }

  .logo {
    position: relative;
    font-family: var(--font-display);
    font-size: var(--text-logo);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    text-decoration: none;
    padding-bottom: 6px;
  }

  .dot {
    color: var(--color-dusty-rose);
    font-size: 1.15em;
  }

  .squiggle {
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 8px;
    color: var(--color-sage);
    transition: color var(--transition);
  }

  .logo:hover .squiggle {
    color: var(--color-dusty-rose);
  }

  /* Theme switch: a moon in the light theme, a sun in the dark one. */
  .theme {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: var(--border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
  }

  .theme:hover {
    color: var(--color-ink);
  }

  .theme .sun,
  :global([data-theme='dark']) .theme .moon {
    display: none;
  }

  :global([data-theme='dark']) .theme .sun {
    display: block;
  }

  .right {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Language switch: two small pills, the current one filled. */
  .lang {
    display: flex;
    padding: 2px;
    border: var(--border);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1;
  }

  .lang a {
    display: grid;
    place-items: center;
    min-width: 36px;
    min-height: 28px;
    padding: 0 8px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    color: var(--color-muted);
  }

  .lang a:hover {
    color: var(--color-ink);
  }

  .lang a[aria-current='true'] {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .menu-button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border: 0;
    border-radius: var(--radius-button);
    background: none;
    cursor: pointer;
  }

  .menu-button:hover {
    background: var(--color-oat);
  }

  .menu-button path {
    transition: transform var(--transition), opacity var(--transition);
    transform-origin: 12px 12px;
  }

  .menu-button[aria-expanded='true'] .l1 {
    transform: translateY(5px) rotate(45deg);
  }

  .menu-button[aria-expanded='true'] .l2 {
    opacity: 0;
  }

  .menu-button[aria-expanded='true'] .l3 {
    transform: translateY(-5px) rotate(-45deg);
  }

  .nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 20;
    background: var(--color-paper);
    border-bottom: var(--border);
    padding: var(--space-2) var(--gutter) var(--space-4);
  }

  .nav.open {
    display: block;
  }

  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    display: block;
    padding: var(--space-3) 0;
    font-size: 18px;
    text-decoration: none;
  }

  .nav a[aria-current='page'] {
    font-weight: 600;
  }

  .nav a[aria-current='page']::before {
    content: '→ ';
    color: var(--color-dusty-rose);
  }

  /* No JS: keep the menu reachable. */
  :global(html:not(.js)) .menu-button {
    display: none;
  }

  :global(html:not(.js)) .nav {
    display: block;
    position: static;
    border: 0;
    padding: 0 0 var(--space-3);
  }

  @media (min-width: 900px) {
    .menu-button {
      display: none;
    }

    .right {
      flex-direction: row-reverse;
      gap: var(--space-4);
    }

    .nav,
    :global(html:not(.js)) .nav {
      display: block;
      position: static;
      border: 0;
      padding: 0;
      background: none;
    }

    .nav ul {
      display: flex;
      gap: var(--space-1);
    }

    .nav a {
      position: relative;
      font-size: 15px;
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-button);
      transition: background var(--transition);
    }

    .nav a:hover {
      background: var(--color-oat);
    }

    .nav a[aria-current='page']::before {
      content: none;
    }

    .nav a[aria-current='page']::after {
      content: '';
      position: absolute;
      left: var(--space-3);
      right: var(--space-3);
      bottom: 2px;
      height: 3px;
      border-radius: 3px;
      background: var(--color-dusty-rose);
    }
  }
</style>
