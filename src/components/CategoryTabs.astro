---
import { categoriesFor, type CategoryKey } from '../utils/shelves';
import { localePath, toLocale, useTranslations } from '../i18n/ui';
interface Props {
  current?: CategoryKey;
  counts?: Partial<Record<CategoryKey, number>>;
}
const { current, counts = {} } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<nav aria-label={t('shelves.categories')}>
  <ul class="chips tabs">
    {
      categoriesFor(locale).map((c) => (
        <li>
          <a class="chip" href={localePath(locale, `/bookshelves/${c.key}/`)} aria-current={c.key === current ? 'page' : undefined}>
            {c.label}
            {counts[c.key] !== undefined && <span class="count">{counts[c.key]}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .tabs {
    list-style: none;
    margin-block: 0;
  }
</style>
