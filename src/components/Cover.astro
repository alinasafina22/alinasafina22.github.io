---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Doodle, { type DoodleName } from './Doodle.astro';

interface Props {
  image?: ImageMetadata;
  alt: string;
  title: string;
  creator?: string;
  /** 'portrait' for books and posters, 'wide' for courses and things. */
  shape?: 'portrait' | 'wide';
  sizes?: string;
  eager?: boolean;
  doodle?: DoodleName;
  /** Language of the title, so the browser hyphenates long words correctly. */
  lang?: string;
}

const {
  image,
  alt,
  title,
  creator,
  shape = 'portrait',
  sizes = '(min-width: 1024px) 340px, (min-width: 640px) 45vw, 50vw',
  eager = false,
  doodle = 'book',
  lang,
} = Astro.props;

// Without a real cover, draw a handmade one. Color is stable per title.
const ACCENTS = ['sage', 'lavender', 'peach', 'dusty-blue', 'butter', 'dusty-rose'];
const hash = [...title].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const accent = ACCENTS[hash % ACCENTS.length];
const tilt = ((hash % 7) - 3) * 2;
---

<div class:list={['cover', shape]}>
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        widths={shape === 'portrait' ? [240, 400, 640] : [480, 800, 1200]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <div class="handmade" style={`--bg: var(--color-${accent})`} role="img" aria-label={alt} lang={lang}>
        <span class="t">{title}</span>
        {creator && <span class="c">{creator}</span>}
        <Doodle name={doodle} size={34} class="d" fill="var(--color-paper)" />
        <span class="spine" style={`--tilt:${tilt}deg`} aria-hidden="true" />
      </div>
    )
  }
</div>

<style>
  .cover {
    container-type: inline-size;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-image);
    border: var(--border);
    background: var(--color-oat);
  }

  .portrait {
    aspect-ratio: 2 / 3;
  }

  .wide {
    aspect-ratio: 16 / 9;
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .handmade {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: 14% 12%;
    background: var(--bg);
    overflow: hidden;
  }

  .t {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(11px, 11cqi, 22px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    overflow-wrap: break-word;
    hyphens: auto;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .wide .t {
    -webkit-line-clamp: 2;
  }

  .c {
    font-family: var(--font-mono);
    font-size: 11px;
    opacity: 0.75;
  }

  .handmade :global(.d) {
    margin-top: auto;
    align-self: flex-end;
    transform: rotate(-10deg);
  }

  .spine {
    position: absolute;
    left: 7%;
    top: -10%;
    bottom: -10%;
    width: 2px;
    background: var(--color-ink);
    opacity: 0.18;
    transform: rotate(var(--tilt));
  }

  .wide .spine {
    display: none;
  }
</style>
