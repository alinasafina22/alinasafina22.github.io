---
import '@fontsource-variable/inter';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { GOATCOUNTER_CODE } from '../data/analytics';
import { LOCALES, localePath, switchLocalePath, toLocale, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path to a social preview image. */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Language of the main content, when it differs from the page language. */
  lang?: Locale;
}

const SITE_NAME = 'azh.';
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);

const {
  title,
  description = t('site.description'),
  image = '/og.png',
  type = 'website',
  noindex = false,
  lang = locale,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} — ${t('site.titleSuffix')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(switchLocalePath(Astro.url.pathname, l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(switchLocalePath(Astro.url.pathname, 'en'), Astro.site)} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f5f1e8" />
    <script is:inline>
      // Pick the theme before the first paint: saved choice, otherwise the system setting.
      (function () {
        var themes = { light: '#f5f1e8', dark: '#2b2c29', burgundy: '#4a2a30' };
        var theme;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {}
        if (!themes[theme]) theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').content = themes[theme];
      })();
    </script>
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={t('rss.title')} href={localePath(locale, '/rss.xml')} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_GB'} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      /* Visit counter: only on the published site, and only once a code is set in src/data/analytics.ts. */
      import.meta.env.PROD && GOATCOUNTER_CODE && (
        <script is:inline async data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`} src="https://gc.zgo.at/count.js" />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <Header />
    <main id="main" lang={lang !== locale ? lang : undefined}>
      <slot />
    </main>
    <Footer />
    <script>
      // Wrap each highlighted code block: show its language and add a copy button.
      const ru = document.documentElement.lang === 'ru';
      const COPY = ru ? 'копировать' : 'copy';
      for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre.astro-code')) {
        const wrap = document.createElement('div');
        wrap.className = 'code-block';
        pre.replaceWith(wrap);
        wrap.append(pre);

        const lang = pre.dataset.language;
        if (lang && lang !== 'plaintext') {
          const label = document.createElement('span');
          label.className = 'code-lang';
          label.textContent = lang;
          wrap.append(label);
        }

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'code-copy';
        btn.textContent = COPY;
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.innerText);
            btn.textContent = ru ? 'скопировано' : 'copied';
          } catch {
            btn.textContent = ru ? 'ошибка' : 'error';
          }
          setTimeout(() => (btn.textContent = COPY), 1500);
        });
        wrap.append(btn);
      }
    </script>
  </body>
</html>
