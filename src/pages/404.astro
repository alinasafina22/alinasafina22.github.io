---
/*
 * GitHub Pages serves this one file for every missing address.
 * Missing Russian addresses (/ru/...) are sent to the Russian version of this page.
 */
import View from '../views/NotFound.astro';
---

<script is:inline>
  if (/^\/ru(\/|$)/.test(location.pathname) && !/^\/ru\/404\/?$/.test(location.pathname)) location.replace('/ru/404/');
</script>
<View />
