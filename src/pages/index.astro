---
import { getEntry, render, getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Doodle from '../components/Doodle.astro';
import NoteCard from '../components/NoteCard.astro';
import ThingCard from '../components/ThingCard.astro';
import Cover from '../components/Cover.astro';
import StatusBadge from '../components/StatusBadge.astro';
import EmptyState from '../components/EmptyState.astro';
import { getNotes } from '../utils/format';
import { getAllShelves, type ShelfItem } from '../utils/shelves';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing src/content/pages/home.md');
const { Content: Intro } = await render(home);

const notes = (await getNotes()).slice(0, 3);
const shelves = await getAllShelves();

// "Currently" = whatever is in progress right now, newest first.
const current: ShelfItem[] = [
  ...shelves.books.filter((i) => i.status.key === 'reading'),
  ...shelves.courses.filter((i) => i.status.key === 'learning'),
  ...shelves['tv-shows'].filter((i) => i.status.key === 'watching'),
]
  .sort((a, b) => b.sortDate - a.sortDate)
  .slice(0, 4);

const verb: Record<string, string> = { books: 'reading', courses: 'learning', 'tv-shows': 'watching' };

const allThings = (await getCollection('things')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featured = allThings.filter((t) => t.data.featured);
const things = (featured.length ? featured : allThings).slice(0, 3);

const sections = [
  { href: '/notes/', title: 'Notes', text: 'Short thoughts, half-baked ideas and things I learned.', doodle: 'loop-arrow', accent: 'sage' },
  { href: '/bookshelves/', title: 'Bookshelves', text: 'Books and courses.', doodle: 'book', accent: 'peach' },
  { href: '/things/', title: 'Things', text: 'Pictures, links and small discoveries.', doodle: 'sparkle', accent: 'lavender' },
  { href: '/about/', title: 'About', text: 'Who is behind this little corner.', doodle: 'cup', accent: 'butter' },
] as const;
---

<BaseLayout description={home.data.description}>
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <p class="hello meta">{home.data.tagline ?? 'a little corner of the internet'}</p>
      <h1 id="hero-title" class="hero-title">
        {home.data.greeting ?? home.data.title}
        <Doodle name="star" size={40} fill="var(--color-butter)" class="hero-star" />
      </h1>
      {home.data.subtitle && <p class="subtitle">{home.data.subtitle}</p>}
      <div class="intro prose" lang={home.data.lang}>
        <Intro />
      </div>
    </section>

    <section class="section" aria-labelledby="recent-notes">
      <div class="section-head">
        <h2 id="recent-notes">Recent notes</h2>
        <a class="more-link" href="/notes/">All notes →</a>
      </div>
      {
        notes.length ? (
          <div class="notes">
            {notes.map((n) => (
              <NoteCard note={n} compact />
            ))}
          </div>
        ) : (
          <EmptyState text="No notes yet." hint="The first one is always the hardest." />
        )
      }
    </section>

    {
      current.length > 0 && (
        <section class="section" aria-labelledby="currently">
          <div class="section-head">
            <h2 id="currently">Currently</h2>
            <a class="more-link" href="/bookshelves/">Bookshelves →</a>
          </div>
          <ul class="current">
            {current.map((item) => (
              <li>
                <a href={item.href} class="current-item">
                  <Cover
                    image={item.cover}
                    alt={item.coverAlt}
                    title={item.title}
                    shape={item.category.layout === 'wide' ? 'wide' : 'portrait'}
                    sizes="88px"
                    doodle={item.category.key === 'courses' ? 'computer' : 'book'}
                  />
                  <span class="current-text">
                    <span class="meta">{verb[item.category.key]}</span>
                    <span class="current-title" lang={item.lang}>{item.title}</span>
                    {item.creator && <span class="current-creator">{item.creator}</span>}
                    <span>
                      <StatusBadge status={item.status} />
                      {item.demo && <span class="demo-badge">demo</span>}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      things.length > 0 && (
        <section class="section" aria-labelledby="things">
          <div class="section-head">
            <h2 id="things">Some things</h2>
            <a class="more-link" href="/things/">All things →</a>
          </div>
          <div class="things">
            {things.map((t) => (
              <ThingCard thing={t} />
            ))}
          </div>
        </section>
      )
    }

    <section class="section" aria-labelledby="explore">
      <h2 id="explore" class="visually-hidden">Explore</h2>
      <ul class="tiles">
        {
          sections.map((s) => (
            <li>
              <a href={s.href} class="tile" style={`--accent: var(--color-${s.accent})`}>
                <Doodle name={s.doodle} size={34} fill="var(--color-paper)" />
                <span class="tile-title">{s.title}</span>
                <span class="tile-text">{s.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-top: var(--space-16);
    padding-bottom: var(--space-8);
  }

  .hello {
    margin-bottom: var(--space-3);
  }

  .hero-title {
    font-size: var(--text-hero);
    font-weight: 700;
    letter-spacing: -0.035em;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .hero-title :global(.hero-star) {
    transform: rotate(12deg);
  }

  .subtitle {
    font-family: var(--font-display);
    font-size: clamp(20px, 3vw, 26px);
    line-height: 1.3;
    max-width: 22ch;
    margin-bottom: var(--space-4);
  }

  .intro {
    color: var(--color-muted);
    font-size: 17px;
  }

  .notes {
    max-width: var(--width-reading);
    border-top: var(--border);
  }

  .current {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .current {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .current-item {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-3);
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--color-card);
    text-decoration: none;
    transition: border-color var(--transition);
  }

  .current-item:hover {
    border-color: var(--color-muted);
  }

  .current-item :global(.handmade .t) {
    font-size: 11px;
  }

  .current-item :global(.handmade .t),
  .current-item :global(.handmade .c),
  .current-item :global(.handmade .d) {
    display: none;
  }

  .current-text {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .current-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.2;
  }

  .current-creator {
    font-size: var(--text-small);
    color: var(--color-muted);
  }

  .current-text .demo-badge {
    margin-left: var(--space-2);
  }

  .things {
    columns: 1;
    column-gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .things {
      columns: 2;
    }
  }

  @media (min-width: 1024px) {
    .things {
      columns: 3;
    }
  }

  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 1024px) {
    .tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .tile {
    display: grid;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-4);
    border-radius: var(--radius-card);
    background: var(--accent);
    text-decoration: none;
    transition: transform var(--transition);
  }

  .tile:hover {
    transform: rotate(-1deg) translateY(-2px);
  }

  .tile-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-card);
  }

  .tile-text {
    font-size: var(--text-small);
  }
</style>
