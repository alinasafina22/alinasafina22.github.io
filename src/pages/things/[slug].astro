---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DateLabel from '../../components/DateLabel.astro';
import TagList from '../../components/TagList.astro';
import { hostOf } from '../../utils/format';

export async function getStaticPaths() {
  const things = await getCollection('things');
  return things.map((thing) => ({ params: { slug: thing.id }, props: { thing } }));
}

const { thing } = Astro.props;
const d = thing.data;
const { Content } = await render(thing);
---

<BaseLayout title={d.title} description={d.description ?? `${d.title}, saved in Things.`} image={d.image?.src} lang={d.lang}>
  <div class="container">
    <Breadcrumbs items={[{ href: '/things/', label: 'Things' }]} />
    <article class="thing">
      <header>
        <p class="top">
          <DateLabel date={d.date} prefix="saved" />
          {d.demo && <span class="demo-badge">demo</span>}
        </p>
        <h1>{d.title}</h1>
        {d.description && <p class="lead">{d.description}</p>}
      </header>

      {
        d.image && (
          <Image
            src={d.image}
            alt={d.imageAlt ?? ''}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 1024px) 900px, 100vw"
            loading="eager"
            class="hero-img"
          />
        )
      }

      {
        d.url && (
          <p class="source">
            <a href={d.url} rel="noopener noreferrer" target="_blank">
              Visit {hostOf(d.url)} <span aria-hidden="true">↗</span>
              <span class="visually-hidden">(external link, opens in a new tab)</span>
            </a>
          </p>
        )
      }

      <div class="prose">
        <Content />
      </div>

      <TagList tags={d.tags} />
    </article>
  </div>
</BaseLayout>

<style>
  .thing {
    padding-top: var(--space-6);
    display: grid;
    gap: var(--space-6);
    max-width: 900px;
  }

  header {
    max-width: var(--width-reading);
  }

  .top {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  h1 {
    margin-bottom: var(--space-3);
  }

  .lead {
    margin: 0;
  }

  .hero-img {
    width: 100%;
    border-radius: var(--radius-large);
    border: var(--border);
  }

  .source {
    margin: 0;
    font-weight: 500;
  }

  .prose:empty {
    display: none;
  }
</style>
