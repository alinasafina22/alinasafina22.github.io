---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CategoryTabs from '../../../components/CategoryTabs.astro';
import ShelfBrowser from '../../../components/ShelfBrowser.astro';
import ReadingStats from '../../../components/ReadingStats.astro';
import { CATEGORIES, getAllShelves, getShelf } from '../../../utils/shelves';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { category: category.key }, props: { category } }));
}

const { category } = Astro.props;
const items = await getShelf(category.key);
const shelves = await getAllShelves();
const counts = Object.fromEntries(CATEGORIES.map((c) => [c.key, shelves[c.key].length]));
---

<BaseLayout title={`${category.label} · Bookshelves`} description={category.description}>
  <div class="container">
    <PageHeader title="Bookshelves" description="Things I've read and learned." doodle="book" accent="var(--color-peach)">
      <div class="tabs"><CategoryTabs current={category.key} counts={counts} /></div>
    </PageHeader>
    {category.key === 'books' && <ReadingStats items={items} />}
    <h2 class="visually-hidden">{category.label}</h2>
    <ShelfBrowser category={category} items={items} />
  </div>
</BaseLayout>

<style>
  .tabs {
    margin-top: var(--space-6);
  }
</style>
